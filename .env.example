TRANSLATE_VENDOR=baidu
TRANSLATE_APP_ID=
TRANSLATE_API_KEY=
# TRANSLATE_ENDPOINT=https://fanyi-api.baidu.com/api/trans/vip/translate

# HMRC 登录信息（可选默认值，优先级最低）：**所有客户共用**的固定值放这里，
# 例如每次注册都用同一个邮箱和密码。客户各自的 Gateway User ID 由程序按客户存到
# workbench-data/credentials.json（工作台）或 hmrc-credentials.json（vat-web），
# 两者按字段拼起来用；程序不会往这个文件里写。
# HMRC_EMAIL=
# HMRC_USER_ID=
# HMRC_PASSWORD=
# HMRC_MFA_PHONE=
# HMRC_SIGN_IN_METHOD=Government Gateway
