{
  "start_url": "https://www.gov.uk/log-in-register-hmrc-online-services",
  "profile_dir": ".browser-profile",
  "artifacts_dir": "artifacts",
  "browser_channel": "chrome",
  "headless": false,
  "allow_live_application": false,
  "max_steps": 250,
  "answers": {
    "Why do you want to register the business for VAT?": "It’s selling goods or services and needs or wants to charge VAT to customers",
    "Country": "China"
  },
  "pages": [
    {
      "match": {
        "path_contains": "/register-for-vat/home-address/international"
      },
      "answers": {
        "Address line 1": "REPLACE_ME",
        "Address line 2": "REPLACE_ME",
        "Country": "China",
        "Postcode": "REPLACE_ME"
      }
    },
    {
      "match": {
        "heading_contains": "Upload a document"
      },
      "answers": {
        "Upload a file": "/absolute/path/to/document.pdf"
      },
      "action": "stop"
    }
  ]
}
